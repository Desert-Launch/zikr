<?xml version="1.0" encoding="utf-8"?>
<!--
  The prayer widget before the app has ever resolved prayer times, or once a
  stale snapshot has run past its window: emblem plus a one-line invitation.
  Same card, same padding, so adding the widget and opening the app once turns
  it into the real thing without the card jumping.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:padding="2dp"
            android:src="@drawable/widget_logo" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:src="@drawable/widget_logo_ring" />
    </FrameLayout>

    <TextView
        android:id="@+id/widget_empty_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:gravity="start|center_vertical"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="@string/prayer_widget_empty"
        android:textColor="@color/widget_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
