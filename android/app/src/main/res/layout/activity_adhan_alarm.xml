<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen adhan alarm (AdhanAlarmActivity). Intentionally static XML with no
  AppCompat/Material dependency: it has to inflate instantly from a cold process
  while the device is locked.

  All strings arrive as intent extras already localized by Dart — nothing here
  is hardcoded copy. layoutDirection=locale keeps it correct in Arabic RTL.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/adhan_alarm_background"
    android:gravity="center"
    android:layoutDirection="locale"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingEnd="28dp">

    <TextView
        android:id="@+id/adhan_alarm_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:alpha="0.75"
        android:letterSpacing="0.06"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/adhan_alarm_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/adhan_alarm_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:alpha="0.85"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:textColor="#FFFFFF"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/adhan_alarm_stop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:background="@drawable/adhan_alarm_button_solid"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:textColor="#0E6B47"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/adhan_alarm_open"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/adhan_alarm_button_outline"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

</LinearLayout>
