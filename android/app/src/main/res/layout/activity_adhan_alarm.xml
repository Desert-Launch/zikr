<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen adhan alarm (AdhanAlarmActivity). Intentionally static XML with no
  AppCompat/Material dependency: it has to inflate instantly from a cold process
  while the device is locked.

  All strings arrive as intent extras already localized by Dart — nothing here
  is hardcoded copy. layoutDirection=locale keeps it correct in Arabic RTL.

  Background is the shared adhan artwork (res/drawable-nodpi/adhan_alarm_bg.jpg —
  JPEG bytes, so the extension has to stay .jpg or release-build PNG crunching
  fails; same image as assets/images/adhan_background_image.png used by the in-app
  SNAdhanRinging screen) under a black scrim, so both adhan screens look
  identical and the white text stays readable over any part of the photo.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/adhan_alarm_bg" />

    <!-- Black at 62% — enough contrast for the body text without washing the
         artwork out. Kept in sync with the in-app screen's scrim. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#9E000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:layoutDirection="locale"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <!-- App identity, so a screen that appears over another app (or from the
             lockscreen) is immediately attributable. Both are filled from
             ApplicationInfo at runtime rather than hardcoded, so they follow the
             manifest label / launcher icon. -->
        <ImageView
            android:id="@+id/adhan_alarm_logo"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="10dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/adhan_alarm_app"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:alpha="0.9"
            android:letterSpacing="0.04"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/adhan_alarm_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:alpha="0.75"
            android:letterSpacing="0.06"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/adhan_alarm_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/adhan_alarm_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:alpha="0.85"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/adhan_alarm_stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:background="@drawable/adhan_alarm_button_solid"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:textColor="#0E6B47"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/adhan_alarm_open"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/adhan_alarm_button_outline"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

    </LinearLayout>

</FrameLayout>
