<?xml version="1.0" encoding="utf-8"?>
<!-- The widget card. Pre-Android-12 launchers have no system corner radius,
     so this fixes one; drawable-v31 overrides it with the system dimen so
     the card matches every other widget on the home screen. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_card" />
    <corners android:radius="20dp" />
</shape>
