<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen alarm backdrop. Matches AppColorsLight.primary → primaryDark from
  lib/core/theme/app_colors.dart so the native alarm reads as the same app.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#0E6B47"
        android:endColor="#0A5639"
        android:type="linear" />
</shape>
