{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  //
  // Every configuration passes dart_defines.json (gitignored) so the Google
  // Maps key reaches both Dart and the Android manifest — without it the
  // mosques screen shows its photo fallback and cannot load mosques.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "quran",
      "request": "launch",
      "type": "dart",
      "toolArgs": ["--dart-define-from-file=dart_defines.json"]
    },
    {
      "name": "quran (profile mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "toolArgs": ["--dart-define-from-file=dart_defines.json"]
    },
    {
      "name": "quran (release mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "toolArgs": ["--dart-define-from-file=dart_defines.json"]
    }
  ]
}
