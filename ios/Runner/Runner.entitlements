<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Critical alerts — lets the adhan pierce Silent mode and Focus on iOS < 26
	  (see ios/Runner/Adhan/AdhanCriticalFallback.swift).

	  THIS IS NOT SELF-SERVICE. Apple must approve it per App ID before the
	  provisioning profile will carry it. Until then, signing a build with this
	  key set will FAIL with "provisioning profile doesn't include the
	  com.apple.developer.usernotifications.critical-alerts entitlement".

	  The justification text to submit, and what to do while waiting, are in
	  docs/ios_critical_alerts_justification.md.

	  CURRENTLY DISABLED — the request is still pending with Apple, so the key
	  is commented out to let device/App Store builds sign. The app still
	  builds and the adhan is delivered as a normal (Silent-mode-respecting)
	  notification; AdhanCriticalFallback detects the missing entitlement at
	  runtime via `criticalAlertSetting` and degrades on its own.

	  ⚠️ ON APPROVAL: uncomment the two lines below, regenerate the
	  provisioning profile, and re-verify the Silent-mode adhan.
	-->
	<!--
	<key>com.apple.developer.usernotifications.critical-alerts</key>
	<true/>
	-->
</dict>
</plist>
